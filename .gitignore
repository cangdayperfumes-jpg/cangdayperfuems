# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated at build time by scripts/generate-blog-data.js, see src/lib/blog.ts
/src/lib/blog-data.generated.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docker
.docker/
docker-compose.override.yml

# one-off migration tool output (scripts/migrate-royal-to-cangday.mjs)
/scripts/migration-report*.json
/scripts/migration-*.log

# supabase CLI local link cache (project ref/pooler info, not secrets, but
# ephemeral local state that shouldn't be versioned)
/supabase/.temp/

.vercel
.env*
